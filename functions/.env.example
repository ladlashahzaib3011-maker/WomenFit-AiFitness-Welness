# WomanFit Firebase Cloud Functions Environment Configuration
# =============================================================
# Store sensitive keys using Firebase Secrets Manager:
# firebase functions:secrets:set GEMINI_API_KEY
# Or set local variables in functions/.env for local emulator testing.

# Google Gemini API Key (Required for live AI responses)
GEMINI_API_KEY=your_gemini_api_key_here

# Client Secret (Optional - Matches BACKEND_PROXY_KEY in Android app if configured)
APP_CLIENT_SECRET=your_womanfit_secret_token_here

# Firebase Security Gateways (Optional, defaults to false)
REQUIRE_FIREBASE_AUTH=false
REQUIRE_APP_CHECK=false
