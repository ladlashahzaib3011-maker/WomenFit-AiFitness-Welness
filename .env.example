# WomanFit Environment Configuration
# ==================================
# Configure secrets securely in the AI Studio Secrets panel (do NOT use local.properties).
#
# Supabase Backend Configuration (Authentication & PostgreSQL):
SUPABASE_URL=DEFAULT_EMPTY
SUPABASE_ANON_KEY=DEFAULT_EMPTY

# Production AI Proxy Architecture:
# - Gemini API keys are NEVER stored in this client APK.
# - The client app talks to the WomanFit Secure AI Proxy (or Firebase Cloud Function).
# - If BACKEND_PROXY_URL is DEFAULT_EMPTY, Coach Maya operates in built-in offline expert mode.
BACKEND_PROXY_URL=DEFAULT_EMPTY
BACKEND_PROXY_KEY=DEFAULT_EMPTY
