# WomanFit Secure AI Backend Proxy Environment Configuration
# ==========================================================

# Server Port (Cloud Run / Railway / Render inject this automatically)
PORT=8080

# Production Gemini API Key (Kept strictly server-side, NEVER exposed in Android APK)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin Configuration (Optional for Auth & App Check Verification)
# On Google Cloud Run, default application credentials authenticate automatically.
# In external environments, set the project ID and path to your service account json:
FIREBASE_PROJECT_ID=womanfit-production
GOOGLE_APPLICATION_CREDENTIALS=
# Set to 'true' to strictly enforce verified Firebase Auth ID tokens on all Coach Maya requests
REQUIRE_FIREBASE_AUTH=false
# Set to 'true' to strictly enforce Google Play Integrity / Firebase App Check tokens
REQUIRE_APP_CHECK=false

# Pre-Shared Dev / Staging Client Secret (Optional fallback for testing)
APP_CLIENT_SECRET=womanfit_secure_secret_2026_change_me

# PostgreSQL / Supabase Database Connection (Server-Side Only - NEVER put in Android APK)
SUPABASE_DB_WOMENFIT=postgresql://USER:PASSWORD@HOST:PORT/postgres
PG_SSL=false
AUTH_JWT_SECRET=replace_with_long_random_jwt_signing_secret

# Node Environment ('production' or 'development')
NODE_ENV=production
